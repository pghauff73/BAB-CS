{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bab-cs.invalid/schemas/experiment-manifest-v1.schema.json",
  "title": "BAB-CS experiment manifest v1",
  "type": "object",
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "sample_count": {"type": "integer", "minimum": 2},
    "accuracy_targets": {
      "type": "array",
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "work_budgets": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "input",
          "state_indices",
          "methods",
          "nominal_steps",
          "authority"
        ]
      }
    }
  },
  "additionalProperties": true
}
